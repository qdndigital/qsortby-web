---
/**
 * HERO VISUAL — a For You feed reordering itself.
 *
 * Draws the per-visitor personalization feature rather than a single merchant
 * collection: a 3x3 tile grid that swaps positions on a loop, which is what a
 * shopper's feed actually does as their session signals come in. Sold-out
 * demotion stays in frame (last tile, dimmed) because it holds even in a
 * personalized feed. No rank numbers — the ▲/▼ badges on the moving tiles are
 * what say "this reordered", not a position count a shopper never sees.
 *
 * Two pairs swap sideways within their row — same two-run, 12s loop as the
 * rest of the site's animated cards — while the rest hold still, so the eye
 * has a fixed frame to judge the movement against.
 */
const PRODUCTS = [
  { name: 'Everyday Tee', slug: 'tee', swap: 'down' },
  { name: 'Trail Runner', slug: 'sneaker', swap: 'up' },
  { name: 'Studio Headphones', slug: 'headphones' },
  { name: 'Canvas Tote', slug: 'tote' },
  { name: 'Classic Cap', slug: 'cap', swap: 'down' },
  { name: 'Chrono Watch', slug: 'watch', swap: 'up' },
  { name: 'Ceramic Mug', slug: 'mug' },
  { name: 'Travel Candle', slug: 'candle-tin' },
  { name: 'Steel Water Bottle', slug: 'bottle', out: true },
];
---
<div class="rw" aria-hidden="true">
  <div class="rw-top">
    <span class="rw-coll"><span class="rw-dot"></span> For you</span>
    <span class="rw-run">Personalized <b>live</b></span>
  </div>

  <div class="rw-grid">
    {PRODUCTS.map((p, i) => (
      <div class={`rw-card${p.swap ? ' swap' + (p.swap === 'up' ? 'l' : 'r') : ''}${p.out ? ' out' : ''}`}>
        <span class="rw-cbody">
          <span class="rw-th"><img src={`/products/${p.slug}.svg`} alt="" width="120" height="120" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></span>
          <span class="rw-nm">{p.name}</span>
          {p.swap ? (
            <span class="rw-dstack">
              <span class={`rw-d a d${p.swap}`}>{p.swap === 'up' ? '▲ 1' : '▼ 1'}</span>
              <span class={`rw-d b d${p.swap === 'up' ? 'down' : 'up'}`}>{p.swap === 'up' ? '▼ 1' : '▲ 1'}</span>
            </span>
          ) : p.out ? (
            <span class="rw-out">Sold out</span>
          ) : (
            <span class="rw-tag-ph" aria-hidden="true">&nbsp;</span>
          )}
        </span>
      </div>
    ))}
  </div>
</div>
