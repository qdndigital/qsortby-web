---
import Base from '../layouts/Base.astro';
import { APP_STORE_URL, DEMO_URL } from '../consts';
import { REVERSE_TRIAL_DAYS } from '../plans';

const title = 'How the ranking engine works — QSortby';
const description =
  'The inside of QSortby: the 10+ signals it ranks on, how it scores your catalog in real time and keeps in-stock first, how it personalizes per shopper — and how it proves the conversion lift with built-in A/B testing and revenue attribution.';
const check = '<svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>';

const groups = [
  {
    kicker: 'Sales',
    title: 'Rank by what sells',
    items: [
      ['Best selling (velocity)', 'Units sold over your window — the classic top-seller.'],
      ['Top revenue (GMV)', 'Summed order value, so high-ticket products rank on the money they make, not just unit count.'],
      ['Most profitable (margin)', 'Product margin — lead with what actually earns.'],
      ['Customer favorites', 'Repeat-purchase rate — the products buyers come back for.'],
    ],
  },
  {
    kicker: 'Momentum',
    title: 'Catch what’s moving now',
    items: [
      ['Trending / rising', 'Sales this window vs. the one before it — surfaces accelerating products, not last season’s hits.'],
      ['Selling fast', 'Velocity relative to remaining stock — what’s about to sell out rises first.'],
    ],
  },
  {
    kicker: 'Engagement & conversion',
    title: 'Rank by shopper behavior',
    items: [
      ['Best converting', 'Conversion rate — the products that turn views into orders.'],
      ['Most added to cart', 'Intent, one step before purchase.'],
      ['Most clicked / highest CTR', 'What earns the click from the grid.'],
      ['Longest dwell / most impressions', 'Attention captured on the page.'],
    ],
  },
  {
    kicker: 'Catalog',
    title: 'Rank by catalog position',
    // Was 'Rank by product quality' with two entries. 'Top rated' (Bayesian review
    // average) is built but ships DISABLED — `collections/new.tsx` renders it as
    // "Top rated (coming soon)" — and had stayed advertised here after being switched
    // off. Removing it left "quality" describing nothing but recency, hence the
    // retitle. Restore BOTH the entry and the old title the day the option is enabled;
    // a merchant who installs on the strength of it and then can't pick it is a
    // support ticket at best and a listing-accuracy failure at worst.
    items: [
      ['Newest arrivals', 'Freshness — give launches their moment.'],
      ['Manual order', 'Your own sequence, kept in place while everything else re-sorts around it.'],
    ],
  },
];
---
<Base title={title} description={description}>
  <section class="phero">
    <div class="wrap">
      <div class="crumb"><a href="/">~</a> / how it works</div>
      <h1>How the ranking engine <em>works</em>.</h1>
      <p>No black box. You choose the signal, QSortby scores your catalog in real time and keeps in-stock first — or personalizes per shopper — then proves the lift with a built-in A/B test and revenue attribution. Here’s the inside.</p>
    </div>
  </section>

  <!-- ===== 1. THE SIGNALS ===== -->
  <section class="sec">
    <div class="wrap">
      <div class="shead rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span> Step 1 · Choose</span>
        <h2>10+ signals to rank by.</h2>
        <p class="lead-c">Set the rule per collection, over a window you pick — a rolling <b>last N hours/days</b>, or a fixed range like <b>last week</b> or a specific month. Change it anytime; preview before it goes live.</p>
      </div>
      <div class="hiw-grid rv">
        {groups.map((g) => (
          <article class="fb">
            <span class="kicker">{g.kicker}</span>
            <h3>{g.title}</h3>
            <ul class="checklist">
              {g.items.map(([name, desc]) => (
                <li><span set:html={check} /><span><b>{name}</b> — {desc}</span></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== 2. REAL-TIME & INVENTORY-AWARE ===== -->
  <section class="sec alt">
    <div class="wrap">
      <div class="shead rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span> Step 2 · Rank</span>
        <h2>Scored live. In-stock first.</h2>
      </div>
      <div class="hiw-two rv">
        <div>
          <ul class="checklist">
            <li><span set:html={check} /><span><b>Re-scored on every order.</b> Shopify order webhooks feed QSortby directly, so the ranking reflects sales within seconds — not a nightly batch.</span></li>
            <li><span set:html={check} /><span><b>Sold-out steps aside.</b> Out-of-stock products are bucketed to the bottom automatically, and climb back to their earned spot the moment you restock.</span></li>
            <li><span set:html={check} /><span><b>Windowed &amp; deterministic.</b> The order is a transparent function of the signal + window you chose — no mystery. You can see the exact resulting order.</span></li>
            <li><span set:html={check} /><span><b>Preview before publish.</b> Every change shows a before/after diff — added, removed, moved — so nothing goes live until you say so.</span></li>
          </ul>
        </div>
        <div>
          <ul class="checklist">
            <li><span set:html={check} /><span><b>Standard Shopify collections.</b> QSortby maintains native collections and a Best&nbsp;Sellers collection — no theme code, no custom storefront work.</span></li>
            <li><span set:html={check} /><span><b>Per-collection rules.</b> Each collection can rank on a different signal and window — trending for new launches, conversion for a wide core range, availability for seasonal lines.</span></li>
            <li><span set:html={check} /><span><b>Manual override.</b> Reorder or exclude specific products by hand where you want an editorial call; the rest keeps sorting itself.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 3. PERSONALIZATION ===== -->
  <section class="sec">
    <div class="wrap">
      <div class="shead rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span> Step 2½ · Personalize</span>
        <h2>A "For You" feed per shopper.</h2>
        <p class="lead-c">Beyond one order for everyone, QSortby can render a per-visitor feed. Visitors are classified into types you define, and each type gets a ranking that blends weighted signals — a live, personal front row.</p>
      </div>
      <div class="hiw-two rv">
        <div>
          <ul class="checklist">
            <li><span set:html={check} /><span><b>Visitor types you control.</b> New, returning, loyal/VIP — each with its own weighting recipe.</span></li>
            <li><span set:html={check} /><span><b>Blended signals.</b> Top-sellers, recently viewed, session intent, price affinity, category affinity, repeat / replenishment timing, new arrivals, return-rate.</span></li>
          </ul>
        </div>
        <div>
          <ul class="checklist">
            <li><span set:html={check} /><span><b>First-party, cookieless.</b> Built from behavior on your store only — no third-party data, no cross-site tracking.</span></li>
            <li><span set:html={check} /><span><b>Cold-start safe.</b> A brand-new visitor still gets a strong best-sellers order while the feed learns.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 3½. EMOTIONAL LAYER =====
       A whole tier (Growth, $199) rests on this, so the deep-dive page has to
       explain it. The shadow (Pro) vs live-apply (Growth) split is the Pro→Growth
       upgrade hook — keep both sides spelled out here. -->
  <section class="sec alt">
    <div class="wrap">
      <div class="shead rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span> Step 2¾ · Read the session</span>
        <h2>Not who they've been — who they are <em>right now</em>.</h2>
        <p class="lead-c">Recommendation engines rank on purchase history, so a first-time visitor gets nothing and a returning one gets last year's taste. QSortby reads the <b>session in progress</b> — pace, dwell, revisits, comparisons, hesitation — and infers the state the shopper is in before they've bought anything.</p>
      </div>
      <div class="hiw-two rv">
        <div>
          <ul class="checklist">
            <li><span set:html={check} /><span><b>Passive signals only.</b> Nothing is asked of the shopper — no quiz, no login, no survey. The read comes from behaviour your storefront already generates.</span></li>
            <li><span set:html={check} /><span><b>Two axes, not a label.</b> Sessions are placed on arousal (calm ↔ activated) and valence (negative ↔ positive), then mapped to a state and a copy tone. Profiles stay behavioral vectors — never a note saying "this person is sad".</span></li>
            <li><span set:html={check} /><span><b>Confidence-gated.</b> A low-confidence read falls back to your standard best-sellers order rather than guessing at a shopper.</span></li>
          </ul>
        </div>
        <div>
          <ul class="checklist">
            <li><span set:html={check} /><span><b>Shadow first (Pro).</b> The layer classifies and reports but changes <i>nothing</i> on your storefront. You see the state mix across your sessions and the ranking it <i>would</i> have served — a read-only preview, zero risk.</span></li>
            <li><span set:html={check} /><span><b>Live apply (Growth).</b> The inferred state reorders that shopper's feed in real time, and the same A/B + attribution machinery from Step 3 measures whether it actually paid.</span></li>
            <li><span set:html={check} /><span><b>Cost-capped by design.</b> Per-session inference has a real running cost, so sessions are sampled rather than all inferred, classifications and product embeddings are cached, and every store has a daily ceiling. Hit the cap and it falls back to rule-based ranking — never to a broken feed.</span></li>
          </ul>
        </div>
      </div>
      <p class="kicker" style="text-align:center;margin-top:1.75rem;max-width:64ch;margin-inline:auto">Personalization is never used to manufacture pressure — no false urgency, no exploiting a low mood. The point is relevance, not leverage.</p>
    </div>
  </section>

  <!-- ===== 4. THE PROOF LOOP ===== -->
  <section class="sec alt">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span> Step 3 · Prove</span>
        <h2>How we answer <em>"maximum conversion value."</em></h2>
        <p class="lead-c">You don’t have to trust the sort. QSortby runs it as an experiment and measures the money it actually drove.</p>
      </div>

      <div class="ab-panel rv">
        <div class="ab-exp" aria-hidden="true">
          <div class="ab-col">
            <span class="ab-hd">A · Control</span>
            <span class="ab-bar b1"></span><span class="ab-bar b2"></span><span class="ab-bar b3"></span>
            <span class="ab-cvr">CVR 1.9%</span>
          </div>
          <div class="ab-vs">vs</div>
          <div class="ab-col ab-b">
            <span class="ab-hd">B · QSortby sort</span>
            <span class="ab-bar b1 win"></span><span class="ab-bar b2"></span><span class="ab-bar b3"></span>
            <span class="ab-cvr ab-up">CVR 2.6% <em>▲</em></span>
          </div>
        </div>
        <div class="ab-meterwrap" aria-hidden="true">
          <span class="ab-meter"><i></i></span>
          <span class="ab-verdict">96% significant — <b>B wins</b></span>
        </div>
        <p class="ab-cap">Illustrative. QSortby splits visitors between your current order and the new sort, then reports the real funnel each drove.</p>
      </div>

      <div class="hiw-two rv" style="margin-top:2.5rem">
        <div>
          <ul class="checklist">
            <li><span set:html={check} /><span><b>Visitor-split A/B.</b> Shoppers are deterministically split between control (your current order) and the QSortby sort — the same visitor always sees the same arm.</span></li>
            <li><span set:html={check} /><span><b>The full funnel, per arm.</b> Impressions → clicks (CTR) → add-to-cart → orders, measured for each variant from a first-party pixel.</span></li>
          </ul>
        </div>
        <div>
          <ul class="checklist">
            <li><span set:html={check} /><span><b>Revenue attribution.</b> Orders are tied back to the QSortby feed a shopper interacted with, so you see <b>influenced revenue</b> per variant — not just clicks.</span></li>
            <li><span set:html={check} /><span><b>Statistical significance.</b> QSortby won’t crown a winner on noise — it reports confidence, so you ship the sort the data actually supports.</span></li>
          </ul>
        </div>
      </div>
      <p class="kicker" style="text-align:center;margin-top:1.75rem;max-width:64ch;margin-inline:auto">Attribution is influenced / last-touch — it shows which sort a converting shopper engaged with, an honest directional read of lift, not a lab-grade incrementality study.</p>
    </div>
  </section>

  <!-- ===== 4½. RAISE THE ORDER =====
       Sits after "Prove" because it's the same engine pointed at a different
       question: ranking decides which products a shopper meets, these decide
       what else joins the basket. Uses the same ranked pool, so nothing here is
       a second list to maintain. Tier badges match docs/PRICING.md § 4a. -->
  <section class="sec alt">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span> Step 4 · Raise the order</span>
        <h2>The same ranking, pointed at <em>the basket.</em></h2>
        <p class="lead-c">Once a shopper has chosen, the question changes from "what should they find" to "what else belongs in this order". QSortby answers it from the same live signals — so every suggestion is something that's selling and in stock, never a static list you maintain by hand.</p>
      </div>

      <div class="hiw-two rv">
        <div>
          <ul class="checklist">
            <li><span set:html={check} /><span><b>Cart drawer &amp; cart page.</b> Suggests what's selling fastest right now, skipping anything already in the cart. <i>Free plan.</i></span></li>
            <li><span set:html={check} /><span><b>Free-shipping progress.</b> Shows the gap to your threshold and suggests a product that actually closes it — never a $5 item against $40 missing. <i>Free plan.</i></span></li>
            <li><span set:html={check} /><span><b>Frequently bought together.</b> Real co-purchase pairs from your own orders; falls back to best sellers until there's enough pair data, so the block is never empty. <i>Starter.</i></span></li>
          </ul>
        </div>
        <div>
          <ul class="checklist">
            <li><span set:html={check} /><span><b>Thank-you page.</b> The order is already placed, so an offer here can't cost the conversion. Every payment method, every Shopify plan. <i>Starter.</i></span></li>
            <li><span set:html={check} /><span><b>Popups, any page.</b> Fire on add-to-cart, exit intent, or a cart near free shipping — gated by AND/OR rules so they don't fire at everyone. <i>Pro.</i></span></li>
            <li><span set:html={check} /><span><b>Inside checkout.</b> Runs before payment, so an accepted offer joins the <i>same</i> order rather than starting a second one. Shopify restricts this surface to Plus. <i>Growth.</i></span></li>
          </ul>
        </div>
      </div>

      <p class="kicker" style="text-align:center;margin-top:1.75rem;max-width:64ch;margin-inline:auto">
        Sold-out and already-in-cart products are filtered out of every surface, and a failed request hides the
        section rather than blocking the cart. On <b>Growth</b>, the emotional read chooses between the
        candidates — same cart, different suggestions for an anxious shopper and a celebratory one.
      </p>
    </div>
  </section>

  <!-- ===== 5. PRIVACY & DATA ===== -->
  <section class="sec">
    <div class="wrap">
      <div class="shead rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span> Data &amp; privacy</span>
        <h2>Your data, used to rank your store.</h2>
      </div>
      <div class="hiw-two rv">
        <div>
          <ul class="checklist">
            <li><span set:html={check} /><span><b>First-party only.</b> A pixel on your storefront — no third-party cookies, no cross-site tracking, nothing sold or shared.</span></li>
            <li><span set:html={check} /><span><b>GDPR-ready.</b> Shopify’s data-request and redaction webhooks are honored; visitor data is purged on request.</span></li>
          </ul>
        </div>
        <div>
          <ul class="checklist">
            <li><span set:html={check} /><span><b>Coarse by design.</b> IP addresses are anonymized before storage; profiles are behavioral, not identity.</span></li>
            <li><span set:html={check} /><span><b>Shopify-native billing.</b> A permanent <b>Free</b> plan, {REVERSE_TRIAL_DAYS} days of full access on install, and paid plans billed through Shopify’s Billing API on your normal invoice.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHAT'S ON WHICH PLAN =====
       This page describes every capability as if it were all available. Without
       this pointer a merchant reads the whole deep-dive and then hits a paywall
       they didn't expect — say it here instead. -->
  <section class="sec" style="padding-top:0">
    <div class="narrow">
      <div class="ps rv">
        <div class="ps-col good">
          <span class="tag">Included on every plan, including Free</span>
          <ul>
            <li><span class="mk" set:html={check} /> Real-time ranking on the signals above, in-stock first</li>
            <li><span class="mk" set:html={check} /> Sold-out demotion and restock promotion</li>
            <li><span class="mk" set:html={check} /> A/B testing and revenue attribution — the whole Step 3 loop</li>
            <li><span class="mk" set:html={check} /> Manual override and before/after preview</li>
          </ul>
        </div>
        <div class="ps-col bad">
          <span class="tag">Needs a paid plan</span>
          <ul>
            <li><span class="mk" set:html={check} /> More than one managed collection — Starter and up</li>
            <li><span class="mk" set:html={check} /> Per-shopper "For You" feed and a tunable window — Starter and up</li>
            <li><span class="mk" set:html={check} /> Customer-event analytics and AI authoring — Pro and up</li>
            <li><span class="mk" set:html={check} /> Emotional layer: shadow preview on Pro, applied live on Growth</li>
          </ul>
        </div>
      </div>
      <p class="kicker" style="text-align:center;margin-top:1.5rem"><a href="/pricing" style="text-decoration:underline">See the full plan comparison →</a></p>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="sec alt" style="padding-top:0;border-block:0">
    <div class="wrap">
      <div class="cta rv">
        <span class="eyebrow"><span class="dot"></span> Get started</span>
        <h2>See the engine on <em>your</em> catalog.</h2>
        <p>Install free and run it on one collection — or book a 15-minute demo and we’ll screen-share the experiment + attribution on your real collections.</p>
        <div class="hero-cta" style="justify-content:center">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Install free <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a href={DEMO_URL} class="btn btn-ghost btn-lg">Book a demo</a>
        </div>
      </div>
    </div>
  </section>
</Base>
