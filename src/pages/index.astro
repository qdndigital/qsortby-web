---
import Base from '../layouts/Base.astro';
import StorefrontHero from '../components/StorefrontHero.astro';
import EmotionMap from '../components/EmotionMap.astro';
import SortConsole from '../components/SortConsole.astro';
import IntroVideo from '../components/IntroVideo.astro';
import { APP_STORE_URL, DEMO_URL } from '../consts';
import { PLANS, REVERSE_TRIAL_DAYS, TEASER_BULLETS } from '../plans';

const title = 'QSortby — Collection Merchandising for Shopify';
const description =
  'QSortby merchandises every Shopify collection automatically — ranked by live demand, personalized per shopper by emotional AI, and A/B-tested for revenue.';

// Teaser shows the whole four-tier LADDER, not two anchors — the point of the
// section is that each step adds one thing, which two cards can't show. The full
// list per plan is on /pricing.
//
// The count itself lives in plans.ts next to the lists it slices, because each
// `features` array is ORDERED so that its first TEASER_BULLETS entries are the
// teaser set (marked with a comment at the boundary). Keeping the number here
// let an inserted bullet change the home page without anyone touching this file.

const mk = '<svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>';
const x = '<svg viewBox="0 0 24 24"><path d="M6 6l12 12M6 18L18 6"/></svg>';
---
<Base title={title} description={description}>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="wrap herogrid">
      <div class="hero-copy">
        <span class="eyebrow"><span class="dot"></span> Built for Shopify</span>
        <h1>The storefront that <em>merchandises itself.</em></h1>
        <p class="lead">
          QSortby re-ranks every collection by live demand, personalizes it for each shopper, and proves the
          lift with a built-in A/B test — so your best products always lead. No theme code.
        </p>
        <div class="hero-cta">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Install free <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a href={DEMO_URL} class="btn btn-line btn-lg">Book a demo</a>
        </div>
        <p class="hero-note">Free plan forever · {REVERSE_TRIAL_DAYS} days full access on install · No card, no theme code</p>
      </div>
      <div class="hero-viz"><StorefrontHero /></div>
    </div>
  </section>

  <!-- ===================== TRUST BAR ===================== -->
  <section style="padding:1rem 0 0">
    <div class="wrap">
      <div class="trustbar rv">
        <span class="ti"><svg viewBox="0 0 24 24"><path d="M12 3l8 4v6c0 5-4 7-8 8-4-1-8-3-8-8V7z"/></svg> Built for Shopify</span>
        <span class="sep"></span>
        <span class="ti"><svg viewBox="0 0 24 24"><path d="M12 2l8 4v6c0 5-4 8-8 10-4-2-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg> GDPR-ready</span>
        <span class="sep"></span>
        <span class="ti"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg> Free plan, no card</span>
        <span class="sep"></span>
        <span class="ti"><svg viewBox="0 0 24 24"><path d="M13 2L3 14h7l-1 8 10-12h-7z"/></svg> Real-time</span>
        <span class="sep"></span>
        <span class="ti"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/></svg> No theme code</span>
      </div>
    </div>
  </section>

  <!-- ===================== INTRO VIDEO =====================
       High on the page — right after the trust bar, before the first wall of
       argument — because a visitor who would rather be shown than told should
       not have to hunt for it. The hero keeps its own trust bar directly beneath
       it; the video takes the next slot.

       Renders only when the asset exists (see public/video/README.md), so the
       page is complete with or without it. -->
  <IntroVideo duration="1:37" />

  <!-- ===================== WHY NOT THE BUILT-IN SORT ===================== -->
  <!-- This section exists to answer the objection that kills most installs:
       "Shopify already has a Best selling sort — why would I pay for this?"
       Keep it high on the page; it precedes every feature argument. -->
  <section class="sec">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span> Why not the built-in sort</span>
        <h2>Shopify can sort by best selling. It can't tell you <em>what that cost you.</em></h2>
        <p class="lead-c">Shopify's native sort is one fixed rule applied blindly to everyone, forever. That's the bar QSortby is measured against — so here it is, side by side.</p>
      </div>

      <div class="ps rv">
        <div class="ps-col bad">
          <span class="tag">Shopify “Best selling”</span>
          <ul>
            <li><span class="mk" set:html={x} /> One sort key for the whole collection — no window you can tune</li>
            <li><span class="mk" set:html={x} /> Sold-out products hold their position until you step in</li>
            <li><span class="mk" set:html={x} /> Same order for every shopper, first visit or fiftieth</li>
            <li><span class="mk" set:html={x} /> No margin, conversion-rate or stock-cover option</li>
            <li><span class="mk" set:html={x} /> No before/after, no attributed revenue — you can't tell if it worked</li>
          </ul>
        </div>
        <div class="ps-col good">
          <span class="tag">QSortby</span>
          <ul>
            <li><span class="mk" set:html={mk} /> A rolling window <b>you</b> choose — 24 hours for trends, 30 days for stability</li>
            <li><span class="mk" set:html={mk} /> Sold-out demoted the moment stock hits zero, promoted back on restock</li>
            <li><span class="mk" set:html={mk} /> Optional per-shopper feed — each visitor gets their own order</li>
            <li><span class="mk" set:html={mk} /> 10+ signals: velocity, revenue, margin, conversion, trend, selling-fast</li>
            <li><span class="mk" set:html={mk} /> Every sort A/B-tested with attributed revenue and a significance verdict</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FEATURE SHOWCASE (interactive) =====================
       Replaces the old static feature-bento grid with one live, interactive
       console: pick a signal (or a shopper) and the storefront re-ranks itself —
       demonstrating auto-sort + real-time + inventory-aware + personalization in a
       single object. See src/components/SortConsole.astro. -->
  <section class="sec alt">
    <div class="wrap">
      <SortConsole />
    </div>
  </section>

  <!-- ===================== EMOTIONAL AI SPOTLIGHT =====================
       This is the category differentiator and the whole basis of the $199 tier,
       so it gets a section of its own rather than a card in the grid above.
       The map is the asset no competitor can copy-paste — keep it here. -->
  <section class="sec">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:3rem">
        <span class="eyebrow"><span class="dot"></span> Emotional AI</span>
        <h2>Other engines know who a shopper <em>has been</em>. QSortby knows who they are <em>right now</em>.</h2>
        <p class="lead-c">Recommendation engines rank on purchase history, so a first-time visitor gets nothing and a returning one gets last year's taste. QSortby reads the session in progress and adapts to the state the shopper is actually in — no history, no login, no cold start.</p>
      </div>

      <div class="espot rv">
        <div>
          <EmotionMap />
        </div>

        <div>
          <ol class="ladder">
            <li>
              <span class="n">1</span>
              <div>
                <b>It reads the session, not the CRM</b>
                <p>Pace, dwell, revisits, comparisons, variant switches, hesitation before the cart — signals your storefront already produces. Nothing is asked of the shopper: no quiz, no login, no survey.</p>
              </div>
            </li>
            <li>
              <span class="n">2</span>
              <div>
                <b>It places them on two axes, not in a bucket</b>
                <p>How activated they are, and whether the mood is positive or negative — which resolves to one of twelve states and a matching copy tone. Profiles stay behavioural vectors; nothing is ever stored saying "this person is sad".</p>
              </div>
            </li>
            <li>
              <span class="n">3</span>
              <div>
                <b>It reorders that shopper's feed</b>
                <p>An anxious shopper gets reassurance — reviews, returns, no pressure. A celebratory one gets the premium pick. A tired one gets fewer, easier choices. Low confidence falls back to your standard best-sellers order rather than guessing.</p>
              </div>
            </li>
          </ol>

          <div class="etiers">
            <div class="etier">
              <div class="et-h"><span class="et-p">Pro</span><span class="et-pr">$99</span></div>
              <b>Look before you apply</b>
              <p>The layer classifies and reports, but changes nothing on your storefront. You see the state mix across your sessions and the ranking it <i>would</i> have served.</p>
            </div>
            <div class="etier on">
              <div class="et-h"><span class="et-p">Growth</span><span class="et-pr">$199</span></div>
              <b>Applied live, per shopper</b>
              <p>The inferred state reorders the feed in real time — with the same A/B test and revenue attribution behind it, so you see what it earned.</p>
            </div>
          </div>

          <p style="margin-top:1.5rem">
            <a href="/how-it-works" class="btn btn-line">How the emotional read works <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </p>
        </div>
      </div>

      <p class="kicker rv" style="text-align:center;margin-top:2.5rem;max-width:62ch;margin-inline:auto">
        Relevance, never leverage — no manufactured urgency, and never exploiting a low mood to force a sale.
      </p>
    </div>
  </section>

  <!-- ===================== THE RANKING ENGINE ===================== -->
  <section class="sec alt">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span> The ranking engine</span>
        <h2>Ranked for conversion — and <em>proven</em>, not guessed.</h2>
        <p class="lead-c">No black box. You pick the signal, QSortby scores your catalog live and keeps in-stock first — or personalizes per shopper — then a built-in A/B test and revenue attribution prove how much it actually lifted.</p>
      </div>

      <div class="steps rv" style="margin-bottom:2.75rem">
        <div class="step">
          <div class="sn">01 · Choose</div>
          <h3>Pick the signal</h3>
          <p>Rank each collection by any of 10+ live signals — velocity, revenue, margin, conversion rate, trending momentum, selling-fast, repeat buyers, engagement, dwell time, newest — over a rolling or fixed window you set.</p>
        </div>
        <div class="step">
          <div class="sn">02 · Rank</div>
          <h3>Score live, in-stock first</h3>
          <p>Every order re-scores the catalog within seconds. Sold-out sinks to the bottom, restocks climb back — so shoppers only meet products they can actually buy.</p>
        </div>
        <div class="step">
          <div class="sn">03 · Prove</div>
          <h3>A/B it, keep the winner</h3>
          <p>Test any sort against your current order. QSortby measures clicks → cart → attributed revenue and calls statistical significance — so the winning sort is the one the data picks, not a guess.</p>
        </div>
      </div>

      <div class="ab-panel rv">
        <div class="ab-exp" aria-hidden="true">
          <div class="ab-col">
            <span class="ab-hd">A · Control</span>
            <span class="ab-bar b1"></span><span class="ab-bar b2"></span><span class="ab-bar b3"></span>
            <span class="ab-cvr">CVR 1.9%</span>
          </div>
          <div class="ab-vs">vs</div>
          <div class="ab-col ab-b">
            <span class="ab-hd">B · QSortby sort</span>
            <span class="ab-bar b1 win"></span><span class="ab-bar b2"></span><span class="ab-bar b3"></span>
            <span class="ab-cvr ab-up">CVR 2.6% <em>▲</em></span>
          </div>
        </div>
        <div class="ab-meterwrap" aria-hidden="true">
          <span class="ab-meter"><i></i></span>
          <span class="ab-verdict">96% significant — <b>B wins</b></span>
        </div>
        <p class="ab-cap">
          Illustration of the experiment report, not a result claim. Every sort can be A/B-tested against your
          current order; QSortby tracks clicks → add-to-cart → attributed revenue and calls significance, so the
          numbers you act on are your store's own.
        </p>
      </div>

      <div class="stats rv">
        <div class="s"><b><em>10+</em></b><span>ranking signals</span></div>
        <div class="s"><b>Real-time</b><span>re-scored every order</span></div>
        <div class="s"><b>A/B</b><span>tested for significance</span></div>
        <div class="s"><b>Attributed</b><span>revenue per sort</span></div>
      </div>
      <p class="rv" style="text-align:center;margin-top:2rem">
        <a href="/how-it-works" class="btn btn-line">See exactly how it ranks <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </p>
    </div>
  </section>

  <!-- ===================== UPSELL SURFACES =====================
       Ranking decides WHICH products a shopper meets; these decide what else
       goes in the basket once they've chosen. Placed after the ranking engine
       because that's the order the value arrives in — and kept as its own
       section rather than a bullet in pricing, because six surfaces is a second
       reason to install, not a plan detail.

       Every claim here is gated per tier (docs/PRICING.md § 4a in the app repo);
       the badges say which, so the section can't over-promise what Free gets. -->
  <section class="sec">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <span class="eyebrow" style="justify-content:center"><span class="dot"></span> Raise the order</span>
        <h2>Sorting decides what they find. These decide <em>what else goes in the bag.</em></h2>
        <p class="lead-c">Six offer surfaces across the journey, all fed by the same live ranking — so what gets suggested is what's actually selling and actually in stock, never a static list you have to maintain.</p>
      </div>

      <div class="steps rv">
        <div class="step">
          <div class="sn">Cart drawer + cart page</div>
          <h3>Cart upsell</h3>
          <p>Suggests what's selling fastest right now, skipping anything already in the cart. Ranked from your real orders, not a hand-picked list that goes stale.</p>
          <span class="utag on">On every plan</span>
        </div>
        <div class="step">
          <div class="sn">Cart drawer + cart page</div>
          <h3>Free-shipping progress</h3>
          <p>Shows how far the cart is from the threshold — and suggests a product that actually closes the gap, never a $5 item against $40 missing.</p>
          <span class="utag on">On every plan</span>
        </div>
        <div class="step">
          <div class="sn">Product page</div>
          <h3>Frequently bought together</h3>
          <p>Real co-purchase pairs from your own order history. Until there's enough pair data it falls back to your best sellers, so the block is never empty.</p>
          <span class="utag">Starter</span>
        </div>
        <div class="step">
          <div class="sn">Order-status page</div>
          <h3>Thank-you upsell</h3>
          <p>The order is already placed, so an offer here can't cost you the conversion. Works on every payment method and every Shopify plan.</p>
          <span class="utag">Starter</span>
        </div>
        <div class="step">
          <div class="sn">Any page</div>
          <h3>Popup upsell</h3>
          <p>Fires on a moment you choose — after an add to cart, on exit intent, or once the cart is near free shipping. Gated by AND/OR rules so it doesn't fire at everyone.</p>
          <span class="utag">Pro</span>
        </div>
        <div class="step">
          <div class="sn">Inside checkout</div>
          <h3>In-checkout upsell</h3>
          <p>Runs before payment, so an accepted offer joins the <i>same</i> order instead of starting a second one. Shopify limits this surface to Plus stores.</p>
          <span class="utag">Growth · Plus</span>
        </div>
      </div>

      <p class="kicker rv" style="text-align:center;margin-top:2.25rem;max-width:64ch;margin-inline:auto">
        On <b>Growth</b>, the emotional read reaches inside these too — an anxious shopper and a celebratory
        one get different suggestions from the same cart.
      </p>
    </div>
  </section>

  <!-- ===================== SETUP ===================== -->
  <section class="sec">
    <div class="wrap">
      <div class="shead rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span> Setup</span>
        <h2>Live in three steps.</h2>
      </div>
      <div class="steps">
        <div class="step rv"><div class="sn">01</div><h3>Install</h3><p>Add QSortby from the App Store. No theme edits, no card.</p></div>
        <div class="step rv"><div class="sn">02</div><h3>Pick a signal</h3><p>Choose how each collection sorts. Preview the exact before/after.</p></div>
        <div class="step rv"><div class="sn">03</div><h3>It sorts itself</h3><p>Real-time ordering, sold-out demoted, revenue attributed. Done.</p></div>
      </div>
    </div>
  </section>

  <!-- ===================== PRICING TEASER ===================== -->
  <section class="sec alt">
    <div class="wrap">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span> Pricing</span>
        <h2>Start free. Upgrade when <em>your numbers</em> say so.</h2>
        <p class="lead-c">Every install opens with {REVERSE_TRIAL_DAYS} days of full access — then settles onto the Free plan and keeps running. The app is never locked or switched off. Each step up adds exactly one thing.</p>
      </div>
      <div class="plans plans-4 rv">
        {PLANS.map((p) => (
          <div class={p.feat ? 'plan feat' : 'plan'}>
            {p.badge && <span class="badge">{p.badge}</span>}
            <span class="ptag">{p.name}</span>
            <div class="price"><b>{p.price}</b><span>/ month</span></div>
            <p class="pdesc">{p.desc}</p>
            <ul>
              {p.features.slice(0, TEASER_BULLETS).map((f) => <li><span set:html={mk} /> {f}</li>)}
            </ul>
            <a href={APP_STORE_URL} class={p.feat ? 'btn btn-accent w-full' : 'btn btn-line w-full'}>
              {p.price === '$0' ? 'Install free' : 'Start free'}
            </a>
          </div>
        ))}
      </div>
      <p class="kicker" style="text-align:center;margin-top:1.75rem">
        <a href="/pricing" style="text-decoration:underline">Compare all four plans in full →</a>
        <span style="display:block;margin-top:.6rem">Billed via Shopify · cancel anytime</span>
      </p>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="sec">
    <div class="narrow">
      <div class="shead ctr rv" style="margin-bottom:2.5rem">
        <span class="eyebrow"><span class="dot"></span> Questions</span>
        <h2>Good to know</h2>
      </div>
      <div class="faq rv">
        <details><summary>Shopify already sorts by best selling — why do I need this?<span class="pm"></span></summary><div class="ans">Because the built-in sort is one fixed rule with no window you control, no sold-out handling, no per-shopper variation, and — the part that matters — <b>no way to tell whether it earned you anything</b>. QSortby lets you choose the signal and the window, demotes sold-out products automatically, can give each shopper their own order, and A/B-tests the result against your current sort with attributed revenue behind it. Install the Free plan on one collection and compare for yourself.</div></details>
        <details><summary>Is there really a free plan, or is it a trial?<span class="pm"></span></summary><div class="ans">A real plan. Every install starts with <b>{REVERSE_TRIAL_DAYS} days of full access</b> to every feature, then drops to <b>Free</b> — one managed collection with real-time ranking, sold-out demotion and revenue attribution, running indefinitely at $0 with no card. Paid plans add collections, personalization and analytics; they don't turn the core back on, because it was never off.</div></details>
        <details><summary>What algorithm does QSortby use to maximize conversion value?<span class="pm"></span></summary><div class="ans">There's no single black-box formula. You pick the ranking signal per collection — sales velocity, revenue, margin, <b>conversion rate</b>, trending momentum, selling-fast, repeat-purchase, engagement or newest — and QSortby scores your catalog in real time, keeping in-stock products first. The part that answers "maximum conversion value": you can <b>A/B-test any sort against your current order</b>, and QSortby measures the funnel it drove (clicks → add-to-cart → <b>influenced revenue</b>, via last-touch attribution) and reports <b>statistical significance</b> — so the winning sort is the one the data proves, not a guess.</div></details>
        <details><summary>What can QSortby sort by?<span class="pm"></span></summary><div class="ans">10+ live signals: sales velocity, revenue (GMV), margin, conversion rate, trending momentum, selling-fast (velocity vs. remaining stock), repeat-purchase rate, engagement (clicks / CTR / dwell / add-to-cart), or newest — over a rolling or fixed window you choose. Per-visitor "For You" ranking blends weighted signals per shopper. Or order any collection by hand.</div></details>
        <details><summary>How do I know it actually lifts sales?<span class="pm"></span></summary><div class="ans">QSortby runs an A/B test between the new sort and your current order, then attributes downstream orders (last-touch) to the feed a shopper interacted with — reporting click-through, add-to-cart and influenced revenue per variant with a significance verdict. You see the lift on your own store, you're not taking it on faith.</div></details>
        <details><summary>What is the Emotional AI layer?<span class="pm"></span></summary><div class="ans">It classifies a shopper's current session — dwell time, revisits, comparisons, hesitation — into an emotional and intent state, then reorders their feed to match. Two levels: <b>Pro</b> gets it as a read-only preview (you see the state mix across your sessions and the ranking it <i>would</i> serve, while your storefront stays exactly as it is), and <b>Growth</b> applies it live per shopper. Cost is capped per store — sessions are sampled, classifications cached, and if a daily ceiling is hit it falls back to your standard ranking rather than degrading the feed.</div></details>
        <details><summary>Is this a sorting app or an upsell app?<span class="pm"></span></summary><div class="ans">Both, and they run off the same engine — that's the point. The ranking decides which products a shopper meets; the upsell surfaces decide what else goes in the basket. Because the offers are fed by the same live signals, they suggest what's <b>actually selling and actually in stock</b> instead of a static list you have to keep updating. Six surfaces: cart drawer and cart page, a free-shipping progress bar, frequently-bought-together on the product page, a thank-you-page offer, popups with AND/OR rules, and an offer inside checkout itself. The first two are on the <b>Free</b> plan.</div></details>
        <details><summary>Will the upsells slow my storefront down?<span class="pm"></span></summary><div class="ans">No. Suggestions are served from a pre-ranked cache rather than computed per shopper, and nothing is added to your theme's critical path — the widgets render after the cart, not before it. If a request fails, the section simply doesn't appear; a cart never blocks on an offer.</div></details>
        <details><summary>Do I need to edit my theme?<span class="pm"></span></summary><div class="ans">No. QSortby maintains standard Shopify collections — add them like any other. No custom code.</div></details>
        <details><summary>What happens when a product sells out?<span class="pm"></span></summary><div class="ans">It drops to the bottom automatically, and returns to its earned spot once restocked.</div></details>
      </div>
    </div>
  </section>

  <!-- ===================== FINAL CTA ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="cta rv">
        <span class="eyebrow"><span class="dot"></span> Get started</span>
        <h2>Let your storefront optimize itself — and <em>prove it did.</em></h2>
        <p>Install free, run it on one collection, and read the attributed revenue in your own dashboard.</p>
        <div class="hero-cta" style="justify-content:center">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Install free <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a href={DEMO_URL} class="btn btn-ghost btn-lg">Book a demo</a>
        </div>
      </div>
    </div>
  </section>
</Base>
