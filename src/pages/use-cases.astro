---
import Base from '../layouts/Base.astro';
import { APP_STORE_URL } from '../consts';
import BookDemo from '../components/BookDemo.astro';

const title = 'Shopify collection sorting by use case — QSortby';
const description =
  'Sold-out products in the front row, new arrivals buried, a catalog too big to drag by hand — nine situations merchants bring to QSortby, what each costs today, and what changes.';

/**
 * NINE SITUATIONS, ONE FORMAT.
 *
 * This page replaced five full-width articles that alternated copy against a
 * dark 252px slab with a 3-D tilt. Three things were wrong with it:
 *   1. Five cases ran to 3.8 screens, so a merchant whose situation was fourth
 *      had to scroll past three that were not theirs. The page is a LIST OF
 *      SITUATIONS, not an argument built in order — it should be enterable at
 *      any point, which is what the jump index and this grid give it.
 *   2. The dark panels were a second visual language on a light site, and each
 *      one carried a product name and an animation that were not the point.
 *   3. Each case argued in two paragraphs plus a checklist that restated them.
 *
 * What a case actually has to carry is three things, and they are the three
 * fields below: the sentence a merchant recognises, what it costs them TODAY,
 * and what changes. The mechanism goes in a mono caption — named, so it can be
 * checked, but never leading.
 *
 * RULE FOR ADDING ONE: `now` must describe the merchant's world without QSortby
 * in it, and `then` may only claim shipped, verifiable behaviour. Three
 * situations we hear and deliberately do NOT list — sorting on variant-level
 * stock, pinning a product to a position, and scheduling a temporary sort —
 * are absent because the app cannot do them yet.
 */
const CASES = [
  {
    id: 'buried-launch',
    group: 'decay',
    tag: 'New arrivals',
    said: 'The drop I launched last week is still buried behind last season.',
    now: 'New arrivals have no sales history, so a best-seller sort files them at the bottom on day one and they never climb out.',
    then: 'Rank on new <em>and</em> selling: recency weighted against real velocity, so a fresh product rises the moment it starts moving.',
    mech: 'newest × velocity',
  },
  {
    id: 'out-of-stock',
    group: 'decay',
    tag: 'Live stock',
    said: 'By Friday half my front row is out of stock.',
    now: "Shopify's own sort leaves a sold-out product exactly where it was until someone steps in and moves it.",
    then: 'In-stock first is the top tie-breaker and cannot be switched off. A product that hits zero sinks within minutes and climbs back on restock.',
    mech: 'in-stock first',
  },
  {
    id: 'too-many-skus',
    group: 'hand',
    tag: 'Scale',
    said: 'I stopped merchandising when the catalog passed a thousand SKUs.',
    now: 'Dragging works at twenty products. It is a chore at two hundred, and after that it stops being something a person can keep up with.',
    then: 'Write the rule once and apply it to as many collections as you want. New products join on their own; you never open the picker again.',
    mech: 'bulk apply · app membership',
  },
  {
    id: 'flat-grid',
    group: 'hand',
    tag: 'Position',
    said: 'Forty products look identical on the grid — position is the only thing deciding the sale.',
    now: 'And that position was set by whoever dragged them last, on a day nobody remembers.',
    then: 'Rank on conversion rate or revenue instead of instinct, so the near-identical products that actually close take the front row.',
    mech: 'conversion · revenue',
  },
  {
    id: 'browse-no-buy',
    group: 'hand',
    tag: 'Per shopper',
    said: 'People browse for ten minutes and leave without buying anything.',
    now: 'One fixed order serves every visitor, whatever they arrived looking for.',
    then: 'A feed built from what this visit is doing — pace, dwell, revisits. No login, no purchase history, no quiz.',
    mech: 'per-shopper feed',
  },
  {
    id: 'stale-window',
    group: 'decay',
    tag: 'Seasonality',
    said: 'Our best sellers change every month. The collection does not.',
    now: 'A sort you set in spring is still ranking on spring demand in October.',
    then: 'Choose the window: a rolling hour for a trend, last month for a season, a fixed range to re-run a campaign.',
    mech: 'window picker',
  },
  {
    id: 'why-first',
    group: 'control',
    tag: 'Explainability',
    said: 'Someone asks why a product is where it is, and I have to answer.',
    now: 'Every app in this category will re-order a collection. Almost none will let you read the rule that did it, let alone change it.',
    then: 'The criteria and their share of influence are yours, written in plain words and editable. On any product, the Similar tab names the signal behind every match it made.',
    mech: 'score breakdown',
    own: true,
  },
  {
    id: 'did-it-work',
    group: 'control',
    tag: 'Proof',
    said: 'I changed the order and I have no idea whether I made it worse.',
    now: 'Reorder, then wait a fortnight and read a sales chart that moved for ten other reasons too.',
    then: 'Run the new order against your current one as a split test, with attributed revenue and a stated minimum sample. Every configuration change is on record with its date, so you can always see which rule was live when a week went the way it did.',
    mech: 'A/B · snapshots · attribution',
    own: true,
  },
  {
    id: 'theme-card',
    group: 'control',
    tag: 'Your theme',
    said: "The app's product cards don't look like the rest of my store.",
    now: 'You take the app\'s markup, or you pay a developer to reskin it every time the theme changes.',
    then: "The feed can hand back your theme's own product-card snippet, so app-chosen products render in your theme rather than beside it.",
    mech: 'theme card',
  },
];

/**
 * THREE BANDS, THREE EACH.
 *
 * Nine cards in one uniform grid gave the eye no landmark: a merchant scanning
 * for their own situation had nine identical objects and no coarse filter. The
 * bands cost almost no words and turn the page into two passes — pick the band,
 * then read three — which is how somebody actually looks for themselves in a
 * list.
 *
 * The split is by what the merchant is losing, not by feature area: the page is
 * organised around their problem, and grouping it by ours would put `newest ×
 * velocity` and `window picker` together purely because both read order lines.
 */
const BANDS = [
  {
    key: 'decay',
    kicker: 'It goes wrong on its own',
    line: 'Nothing broke. The catalogue moved and the order did not follow it.',
  },
  {
    key: 'hand',
    kicker: 'Too big to do by hand',
    line: 'The work is possible, just not at the size the store has grown to.',
  },
  {
    key: 'control',
    kicker: 'You want to stay in charge of it',
    line: 'Automation is only worth having if you can still see, check and undo what it did.',
  },
];
---
<Base title={title} description={description} breadcrumb="Use cases">
  <section class="phero">
    <div class="wrap">
      <div class="crumb"><a href="/">~</a> / use cases</div>
      <h1>Nine sentences merchants say <em>before</em> they go looking for a sorting app.</h1>
      <p>Nobody wakes up wanting to re-order a collection. They open their own store, see something wrong with it, and go looking for a way to stop fixing it by hand. Here is each one, what it costs today, and what changes.</p>

      <nav class="ucjump" aria-label="Jump to a situation">
        {CASES.map((c) => <a href={`#${c.id}`}>{c.tag}</a>)}
      </nav>
    </div>
  </section>

  <!-- One visual, once. The five animated panels this replaced each said a
       version of the same thing — an order rearranging — and said it beside
       copy that had already said it. Stating it once, at full strength, leaves
       the nine cases free to be read rather than illustrated. -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="ucba rv" aria-hidden="true">
        <div class="ucba-p">
          <div class="ucba-h"><b>Your order today</b><span>Manual</span></div>
          <div class="ucba-r dead"><i>1</i><u></u><s style="--w:26%"></s><em class="out">Sold out</em></div>
          <div class="ucba-r"><i>2</i><u></u><s style="--w:44%"></s></div>
          <div class="ucba-r"><i>3</i><u></u><s style="--w:38%"></s></div>
          <div class="ucba-r"><i>4</i><u></u><s style="--w:96%"></s></div>
          <div class="ucba-r"><i>5</i><u></u><s style="--w:70%"></s></div>
        </div>
        <div class="ucba-mid"><span>&rarr;</span></div>
        <div class="ucba-p after">
          <div class="ucba-h"><b>After one sort</b><span>Live</span></div>
          <div class="ucba-r win"><i>1</i><u></u><s style="--w:100%"></s><em class="up">&#9650; 3</em></div>
          <div class="ucba-r"><i>2</i><u></u><s style="--w:73%"></s></div>
          <div class="ucba-r"><i>3</i><u></u><s style="--w:46%"></s></div>
          <div class="ucba-r"><i>4</i><u></u><s style="--w:40%"></s></div>
          <div class="ucba-r dead"><i>5</i><u></u><s style="--w:26%"></s><em class="out">Sold out</em></div>
        </div>
      </div>
      <p class="ucba-cap">The same five products, before and after one run. Illustration, not a result claim.</p>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      {BANDS.map((band) => (
      <div class="ucband">
        <div class="ucband-h">
          <h2>{band.kicker}</h2>
          <p>{band.line}</p>
        </div>
        <div class="ucgrid">
        {CASES.filter((c) => c.group === band.key).map((c) => (
          <article class={c.own ? 'uccard own rv' : 'uccard rv'} id={c.id}>
            <span class="uc-tag">{c.tag}</span>
            <h2 class="uc-said">&ldquo;{c.said}&rdquo;</h2>
            <dl>
              <dt>Today</dt>
              <dd>{c.now}</dd>
              <dt>With QSortby</dt>
              <dd set:html={c.then} />
            </dl>
            <span class="uc-mech">{c.mech}</span>
          </article>
        ))}
        </div>
      </div>
      ))}
      <p class="ucgrid-note">
        Three situations we hear often are not on this list &mdash; sorting on variant-level stock,
        pinning a product to a position, and scheduling a sort for a few days and back.
        The app cannot do them yet, so they are not claimed here.
      </p>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="cta rv">
        <h2>Start with the one that is <em>your</em> store.</h2>
        <p>Install free and point QSortby at a single collection. Nothing publishes until you have seen the new order.</p>
        <div class="hero-cta" style="justify-content:center">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">Install free <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <BookDemo class="btn btn-ghost btn-lg">Book a demo</BookDemo>
        </div>
      </div>
    </div>
  </section>
</Base>
